# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it's already in .gitignore.

# MySQL connection string
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://weis_user:changeme@localhost:3306/weis_db

APP_NAME=WEIS API
ENV=development
DEBUG=True

SECRET_KEY=replace-this-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
