# ===================================================================
# WEIS Platform — Production Environment Configuration
# Copy this file to .env in your production environment (Render, Railway, VPS)
# ===================================================================

# --- Application Settings ---
APP_NAME="Women Empowerment & Inclusion System (WEIS)"
ENV=production
DEBUG=False

# --- Database Tier (MySQL 8.0 / AWS RDS / Google Cloud SQL) ---
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://weis_user:YOUR_STRONG_PASSWORD@your-db-host:3306/weis_db

# --- Cryptographic Security ---
# Generate a secure key in shell: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed frontend domains
CORS_ORIGINS=https://your-frontend.vercel.app,https://weis.org,http://localhost:5173
